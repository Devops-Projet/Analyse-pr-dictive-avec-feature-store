# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_PORT=5000

# API
API_PORT=8000

# Supervision (make monitoring)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=changeme
