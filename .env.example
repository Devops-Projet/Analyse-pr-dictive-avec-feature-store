# Copier ce fichier vers .env et remplacer les valeurs. Ne jamais committer .env.

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=feature_store
POSTGRES_USER=feature_store
